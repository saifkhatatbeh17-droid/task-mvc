@model List<CafeteriaCodeFirst.Models.Product>
<h1>Product List</h1>
@Html.ActionLink("Add New", "Create")
<table class="table table-bordered mt-3">
    <thead><tr>
        <th>Name</th>
        <th>Price</th>
        <th>Quantity</th>
        <th>Category.Name</th>
        <th>Supplier.Name</th>
    </tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(m => item.Name)</td>
            <td>@Html.DisplayFor(m => item.Price)</td>
            <td>@Html.DisplayFor(m => item.Quantity)</td>
            <td>@Html.DisplayFor(m => item.Category.Name)</td>
            <td>@Html.DisplayFor(m => item.Supplier.Name)</td>
        </tr>
    }
    </tbody>
</table>
