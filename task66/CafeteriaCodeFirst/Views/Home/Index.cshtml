<h1>Cafeteria Database</h1>
<p>Connected database: @ViewBag.DatabaseName</p>
<p>Project tables are in the Task6 schema.</p>
<table class="table table-bordered">
    <thead><tr><th>Table</th><th>Number of records</th></tr></thead>
    <tbody>
        <tr><td>Categories</td><td>@ViewBag.Categories</td></tr>
        <tr><td>Suppliers</td><td>@ViewBag.Suppliers</td></tr>
        <tr><td>Products</td><td>@ViewBag.Products</td></tr>
        <tr><td>PurchaseOrders</td><td>@ViewBag.PurchaseOrders</td></tr>
        <tr><td>PurchaseOrderItems</td><td>@ViewBag.PurchaseOrderItems</td></tr>
    </tbody>
</table>
