@model List<Product>
<h1>Products</h1>
@Html.ActionLink("Add New", "Create")
@if (TempData["Error"] is string error)
{
    <p class="alert alert-danger">@error</p>
}
<div class="table-responsive">
<table class="table table-bordered">
<thead><tr><th>Id</th>
<th>Name</th>
<th>Description</th>
<th>Price</th>
<th>Quantity</th>
<th>Category.Name</th>
<th>Supplier.Name</th>
<th>Stock Status</th>
<th>Actions</th></tr></thead>
<tbody>
@foreach (var item in Model)
{
    <tr>
        <td>@item.Id</td>
        <td>@Html.DisplayFor(m => item.Name)</td>
        <td>@Html.DisplayFor(m => item.Description)</td>
        <td>@Html.DisplayFor(m => item.Price)</td>
        <td>@Html.DisplayFor(m => item.Quantity)</td>
        <td>@Html.DisplayFor(m => item.Category!.Name)</td>
        <td>@Html.DisplayFor(m => item.Supplier!.Name)</td>
        <td>@(item.Quantity < 5 ? "Low Stock" : "Available")</td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
            @Html.ActionLink("Details", "Details", new { id = item.Id })
            @using (Html.BeginForm("Delete", "Product", new { id = item.Id }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button class="btn btn-danger btn-sm" type="submit">Delete</button>
            }
        </td>
    </tr>
}
</tbody></table></div>
