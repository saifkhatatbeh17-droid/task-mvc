@model List<Order>
<h1>Orders</h1>
@Html.ActionLink("Add New", "Create")
@if (TempData["Error"] is string error)
{
    <p class="alert alert-danger">@error</p>
}
<div class="table-responsive">
<table class="table table-bordered">
<thead><tr><th>Id</th>
<th>CustomerName</th>
<th>OrderDate</th>
<th>TotalPrice</th>
<th>Status</th>
<th>Employee.FullName</th>
<th>Actions</th></tr></thead>
<tbody>
@foreach (var item in Model)
{
    <tr>
        <td>@item.Id</td>
        <td>@Html.DisplayFor(m => item.CustomerName)</td>
        <td>@Html.DisplayFor(m => item.OrderDate)</td>
        <td>@Html.DisplayFor(m => item.TotalPrice)</td>
        <td>@Html.DisplayFor(m => item.Status)</td>
        <td>@Html.DisplayFor(m => item.Employee!.FullName)</td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
            @Html.ActionLink("Details", "Details", new { id = item.Id })
            @using (Html.BeginForm("Delete", "Order", new { id = item.Id }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button class="btn btn-danger btn-sm" type="submit">Delete</button>
            }
        </td>
    </tr>
}
</tbody></table></div>
