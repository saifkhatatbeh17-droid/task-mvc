@model List<Employee>
<h1>Employees</h1>
@Html.ActionLink("Add New", "Create")
@if (TempData["Error"] is string error)
{
    <p class="alert alert-danger">@error</p>
}
<div class="table-responsive">
<table class="table table-bordered">
<thead><tr><th>Id</th>
<th>FullName</th>
<th>Phone</th>
<th>Email</th>
<th>Position</th>
<th>Salary</th>
<th>HireDate</th>
<th>Orders.Count</th>
<th>Actions</th></tr></thead>
<tbody>
@foreach (var item in Model)
{
    <tr>
        <td>@item.Id</td>
        <td>@Html.DisplayFor(m => item.FullName)</td>
        <td>@Html.DisplayFor(m => item.Phone)</td>
        <td>@Html.DisplayFor(m => item.Email)</td>
        <td>@Html.DisplayFor(m => item.Position)</td>
        <td>@Html.DisplayFor(m => item.Salary)</td>
        <td>@Html.DisplayFor(m => item.HireDate)</td>
        <td>@Html.DisplayFor(m => item.Orders.Count)</td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
            @Html.ActionLink("Details", "Details", new { id = item.Id })
            @using (Html.BeginForm("Delete", "Employee", new { id = item.Id }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button class="btn btn-danger btn-sm" type="submit">Delete</button>
            }
        </td>
    </tr>
}
</tbody></table></div>
