@model Employee
@using Microsoft.AspNetCore.Mvc.Rendering
<h1>Create Employee</h1>
@using (Html.BeginForm("Create", "Employee", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    <div class="mb-3">
        @Html.LabelFor(m => m.FullName)
        @Html.TextBoxFor(m => m.FullName, new { type = "text", @class = "form-control" })
        @Html.ValidationMessageFor(m => m.FullName)
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.Phone)
        @Html.TextBoxFor(m => m.Phone, new { type = "text", @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Phone)
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.Email)
        @Html.TextBoxFor(m => m.Email, new { type = "email", @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Email)
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.Position)
        @Html.TextBoxFor(m => m.Position, new { type = "text", @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Position)
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.Salary)
        @Html.TextBoxFor(m => m.Salary, new { type = "number", step = "0.01", @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Salary)
    </div>
    <div class="mb-3">
        @Html.LabelFor(m => m.HireDate)
        @Html.TextBoxFor(m => m.HireDate, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
        @Html.ValidationMessageFor(m => m.HireDate)
    </div>
    <button class="btn btn-primary" type="submit">Save</button>
}
@Html.ActionLink("Back to List", "Index")
