<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>University Cafeteria</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <header class="bg-dark text-white p-3 mb-4">
        <div class="container">
            <h1 class="h3">University Cafeteria Supply Management System</h1>
            <nav class="d-flex flex-wrap gap-3">
                <a class="text-white" href="@Url.Action("Index", "Supply")">Home</a>
                <a class="text-white" href="@Url.Action("Products", "Supply")">Products</a>
                <a class="text-white" href="@Url.Action("Suppliers", "Supply")">Suppliers</a>
                <a class="text-white" href="@Url.Action("Index", "SupplyRequest")">Create Supply Request</a>
                <a class="text-white" href="@Url.Action("Review", "SupplyRequest")">Review Draft</a>
                <a class="text-white" href="@Url.Action("MyRequests", "SupplyRequest")">My Requests</a>
                <a class="text-white" href="@Url.Action("About", "SupplyRequest")">About</a>
            </nav>
        </div>
    </header>
    <main class="container pb-4">
        @RenderBody()
    </main>
    <footer class="container border-top py-3">University Cafeteria &copy; 2026</footer>
    @RenderSection("Scripts", required: false)
</body>
</html>
