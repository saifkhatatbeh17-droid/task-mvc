@model UniversityCafeteria.Models.SupplyRequest
<h1>Review Draft</h1>
@if (Model.Items.Count == 0)
{
    <p>No products in the draft. Add a product before confirming.</p>
    <a href="@Url.Action("Index", "SupplyRequest")">Create Supply Request</a>
}
else
{
    <p>Request priority: @Model.Priority</p>
    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead><tr><th>Product</th><th>Category</th><th>Quantity</th><th>Unit Price (JD)</th><th>Total (JD)</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr><td>@item.ProductName</td><td>@item.Category</td><td>@item.Quantity</td><td>@item.UnitPrice.ToString("0.00")</td><td>@item.Total.ToString("0.00")</td></tr>
                }
            </tbody>
        </table>
    </div>
    <dl>
        <dt>Subtotal</dt><dd>@Model.Subtotal.ToString("0.00") JD</dd>
        <dt>Preparation Fee</dt><dd>@Model.PreparationFee.ToString("0.00") JD</dd>
        <dt>Discount</dt><dd>@Model.Discount.ToString("0.00") JD</dd>
        <dt>Final Total</dt><dd>@Model.FinalTotal.ToString("0.00") JD</dd>
    </dl>
    <form action="@Url.Action("ConfirmRequest", "SupplyRequest")" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-success">Confirm Request</button>
    </form>
    <a href="@Url.Action("Index", "SupplyRequest")" class="btn btn-outline-primary mt-2">Add More Products</a>
    <form action="@Url.Action("ClearDraft", "SupplyRequest")" method="post" class="mt-2">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-danger">Clear Draft</button>
    </form>
}
