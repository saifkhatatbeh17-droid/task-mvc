@model List<SupplyRequest>
@{
    ViewData["Title"] = "Supply Requests";
}
<h1>Supply Requests</h1>
<p><a asp-action="Create">New Request</a></p>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Date</th>
            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
            {
                <th>User</th>
            }
            <th>Total</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.RequestDate.ToString("yyyy-MM-dd HH:mm")</td>
                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                {
                    <td>@item.User?.FullName</td>
                }
                <td>@item.TotalPrice.ToString("0.00")</td>
                <td>@item.Status</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || item.Status == "Pending")
                    {
                        <span> | </span>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button class="btn btn-link text-danger p-0" type="submit">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
