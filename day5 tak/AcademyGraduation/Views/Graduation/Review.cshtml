@model List<AcademyGraduation.Models.Offer>
@{
    var totals = (List<decimal>)ViewBag.Totals;
}
<h1>Review Graduation Supply Request</h1>
<p>Phase @ViewBag.Phase</p>
<div class="table-responsive">
<table class="table table-bordered table-striped">
    <thead><tr><th>Category</th><th>Supplier</th><th>Offer</th><th>Quantity</th><th>Unit Price (JD)</th><th>Total (JD)</th></tr></thead>
    <tbody>
    @for (int i = 0; i < Model.Count; i++)
    {
        <tr><td>@Model[i].Supplier.Category.Name</td><td>@Model[i].Supplier.Name</td><td>@Model[i].Name</td><td>@Model[i].Quantity</td><td>@Model[i].UnitPrice.ToString("0.00")</td><td>@totals[i].ToString("0.00")</td></tr>
    }
    </tbody>
</table>
</div>
<dl>
    <dt>Total Price</dt><dd id="subtotal">@ViewBag.Subtotal.ToString("0.00") JD</dd>
    <dt>Discount Percentage</dt><dd id="percentage">@ViewBag.DiscountPercentage%</dd>
    <dt>Discount Amount</dt><dd id="discount">@ViewBag.DiscountAmount.ToString("0.00") JD</dd>
    <dt>Final Total</dt><dd id="final">@ViewBag.FinalTotal.ToString("0.00") JD</dd>
</dl>
<a class="btn btn-primary" href="@Url.Action("Index", "Graduation")">Change Selected Offers</a>
